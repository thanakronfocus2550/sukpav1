# SUK PA? V1 local and production environment template

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Telegram notifications (server-only)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Admin login: replace with a newly generated random secret of at least 32 characters
ADMIN_SECRET_KEY=replace-with-a-new-random-secret-at-least-32-characters-long
